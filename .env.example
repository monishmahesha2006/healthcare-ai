# Healthcare AI Platform Environment Configuration

# Application Environment (development, staging, production)
ENVIRONMENT=development
APP_NAME="Healthcare AI Platform"
DEBUG=true

# Security & Authentication
SECRET_KEY=healthcare_ai_super_secret_development_key_change_in_production_min32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite local, PostgreSQL compatible)
# Local SQLite default:
DATABASE_URL=sqlite:///./healthcare_ai.db
# PostgreSQL example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthcare_ai

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# External AI & Cloud Integrations (Optional - platform functions with resilient fallbacks if omitted)
# Google Gemini Generative AI API Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Google Cloud Vision OCR API Key (for prescription and report image OCR)
GOOGLE_VISION_API_KEY=

# Google Places API Key (for Google Care Finder clinic locator)
GOOGLE_PLACES_API_KEY=

# Storage & Upload Limits
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads
