# =============================================================================
# Healthcare AI Platform — Environment Variables Reference
# =============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# For Railway deployment, set these as Railway environment variables in the
# Railway dashboard (NOT as a committed .env file).
# =============================================================================

# ---------------------------------------------------------------------------
# App Settings
# ---------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false

# ---------------------------------------------------------------------------
# Security — REQUIRED: generate a strong random key for production
# Run: python -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------------
SECRET_KEY=REPLACE_WITH_A_STRONG_RANDOM_SECRET_KEY_MIN_32_CHARS

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite (local dev only):
DATABASE_URL=sqlite:///./healthcare_ai.db

# PostgreSQL (Railway — Railway auto-sets this when you add Postgres plugin):
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# NOTE: Railway provides "postgres://" URLs — the app auto-converts them.

# ---------------------------------------------------------------------------
# CORS Origins — comma-separated list of allowed frontend origins
# In Railway: set this to your frontend Railway service public URL
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Example for Railway:
# CORS_ORIGINS=https://your-frontend.up.railway.app,http://localhost:5173

# ---------------------------------------------------------------------------
# Google Gemini API — for AI assistant, report analysis, medicine explainer
# Get yours at: https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---------------------------------------------------------------------------
# Google Vision API — for OCR prescription scanning (optional)
# Get yours at: https://console.cloud.google.com/
# ---------------------------------------------------------------------------
GOOGLE_VISION_API_KEY=

# ---------------------------------------------------------------------------
# Google Places API — for Care Finder map search (optional)
# ---------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=

# ---------------------------------------------------------------------------
# Frontend Environment Variables (Vite — must be prefixed with VITE_)
# Set in the FRONTEND Railway service environment variables.
# ---------------------------------------------------------------------------
# VITE_API_URL=https://your-backend-service.up.railway.app
